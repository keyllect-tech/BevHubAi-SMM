# ============================================================
# BevHubAI — Environment Variables
# Скопируй в .env:  copy .env.example .env
# Всё опционально — без .env проект запускается с настройками по умолчанию.
# ============================================================

# ── Backend (server.js) ──
PORT=3001
# Файл базы SQLite (по умолчанию data/bevhub.db)
# DATABASE_FILE=./data/bevhub.db
# Разрешённые origin фронтенда (через запятую)
FRONTEND_URL=http://localhost:5173
# OpenAI для AI-сценария (без ключа или при ошибке используются шаблоны). Только на сервере!
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Сколько запросов сценария в час разрешено одному workspace (защита от лишних трат)
# SCRIPTS_PER_HOUR=30
# Через сколько часов удаляются загруженные, но неиспользованные изображения
# ORPHAN_FILE_TTL_HOURS=24
# Озвучка (ключи не нужны):
#   auto   — онлайн-голос, если есть интернет, иначе офлайн-голос Windows (по умолчанию)
#   local  — всегда офлайн-голос Windows: не зависит от интернета, лучший вариант для показа
#   google — только онлайн-голос
# TTS_PROVIDER=auto
# Шрифт с кириллицей для субтитров (определяется автоматически)
# SUBTITLE_FONT=C:/Windows/Fonts/arialbd.ttf

# ── Cookie сессии ──
# true только при работе по HTTPS
COOKIE_SECURE=false
# lax — фронтенд и API на одном origin (обычный режим, в dev через прокси Vite).
# none — фронтенд на другом домене, чем API. Требует HTTPS и включает Secure автоматически,
# иначе браузер не пришлёт cookie к картинкам, плееру и скачиванию.
# COOKIE_SAMESITE=lax

# ── Frontend ──
# Пусто = тот же origin (в dev Vite проксирует /api на backend, см. PORT выше).
# Если указываете другой домен — задайте COOKIE_SAMESITE=none и работайте по HTTPS.
# VITE_API_URL=
