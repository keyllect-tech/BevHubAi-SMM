# ============================================================
# BevHubAI — Environment Variables
# ============================================================
# 1. Скопируй этот файл в .env:
#    copy .env.example .env
#
# 2. Заполни реальные значения из Supabase:
#    https://supabase.com → твой проект → Settings → API
# ============================================================

# Supabase Project URL (Project URL)
VITE_SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co

# Supabase Anon Key (anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI API Key (для AI-генерации сценария, опционально)
# VITE_OPENAI_API_KEY=sk-...
