# ============================================================
# BevHubAI — Environment Variables
#
# Скопируйте в .env:  copy .env.example .env   (Windows)
#                      cp .env.example .env    (Linux/macOS)
#
# Все переменные ниже НЕОБЯЗАТЕЛЬНЫ для локального запуска: без .env проект
# стартует на настройках по умолчанию (шаблонные сценарии, локальный FFmpeg,
# SQLite в data/bevhub.db).
#
# Правила безопасности:
#   * реальные ключи хранятся ТОЛЬКО в .env на сервере, .env в git не попадает;
#   * переменные с префиксом VITE_ встраиваются в frontend bundle — секретов там быть не должно.
#
# Значения по умолчанию указаны в комментариях как «по умолчанию: …».
# ============================================================

# ── Backend: сервер и данные ──────────────────────────────────────────────────
# Порт HTTP API. По умолчанию: 3001
PORT=3001
# Файл SQLite. По умолчанию: ./data/bevhub.db (создаётся автоматически)
# DATABASE_FILE=./data/bevhub.db
# Корень проекта разрешён по умолчанию; внешние absolute production-пути требуют
# STORAGE_ALLOWED_ROOTS. Список разделяется системным разделителем (Windows: ;).
# STORAGE_ALLOWED_ROOTS=C:\BevHubData;D:\BevHubMedia
# UPLOADS_DIR=uploads
# TMP_DIR=uploads/tmp
# BACKUP_DIR=data/backups
#
# ISOLATED_TEST_MODE и ISOLATED_TEST_ROOT задаются только в окружении родительского
# процесса, не в .env. ISOLATED_TEST_ROOT должен находиться в системном temp-каталоге.
# Запуск сервера в isolated-режиме пока намеренно заблокирован до завершения защитных этапов.

# ── Безопасность: cookie сессии ───────────────────────────────────────────────
# true только при работе по HTTPS. При COOKIE_SAMESITE=none Secure включается автоматически.
# В production по HTTPS обязательно: COOKIE_SECURE=true
COOKIE_SECURE=false
# lax — frontend и API на одном origin (обычный режим; в dev Vite проксирует /api на backend).
# none — frontend на другом домене, чем API. Требует HTTPS, иначе браузер не пришлёт cookie
#        к картинкам, плееру и скачиванию.
# По умолчанию: lax
# COOKIE_SAMESITE=lax

# ── Безопасность: CORS ────────────────────────────────────────────────────────
# Разрешённые origin фронтенда через запятую. Эти же origin принимаются при
# state-changing запросах (POST/PATCH/DELETE) — защита от CSRF с чужих сайтов.
# По умолчанию: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
# В production укажите реальный домен: FRONTEND_URL=https://app.example.com
FRONTEND_URL=http://localhost:5173

# ── Безопасность: заголовки ───────────────────────────────────────────────────
# CSP по умолчанию отдаётся в режиме отчёта (Content-Security-Policy-Report-Only): нарушения
# только логируются браузером, ничего не блокируется. После чистой проверки: CSP_REPORT_ONLY=false
# CSP_REPORT_ONLY=false
# HSTS (Strict-Transport-Security) добавляется автоматически только для HTTPS-запросов,
# без includeSubDomains и preload — их включают после проверки всех поддоменов.

# ── Frontend (встраивается в bundle на этапе сборки) ──────────────────────────
# Пусто = тот же origin (в dev Vite проксирует /api на backend, см. PORT выше).
# Если frontend обслуживается другим доменом — задайте полный URL API и COOKIE_SAMESITE=none.
# VITE_API_URL=

# ── Dev: прокси Vite ─────────────────────────────────────────────────────────
# Куда Vite проксирует /api в dev-режиме. По умолчанию: http://localhost:$PORT
# API_PROXY_TARGET=http://localhost:3001

# ── Ограничения и уборка ──────────────────────────────────────────────────────
# Сколько запросов сценария в час разрешено одному workspace (защита от лишних трат
# у оператора). Квота списывается только когда активен хотя бы один AI-провайдер.
# По умолчанию: 30
# SCRIPTS_PER_HOUR=30
# Через сколько часов файл считается «старым» при инвентаризации и уборке.
# По умолчанию: 24
# ORPHAN_FILE_TTL_HOURS=24

# ── Уборка файлов: kill-switch ────────────────────────────────────────────────
# Автоматическое удаление файлов ВЫКЛЮЧЕНО, пока переменные не заданы явно.
# Порядок read-only: CLEANUP_*_MODE=dry-run (только отчёт, ничего не удаляется).
#   off      — не трогать файлы (по умолчанию, в том числе при опечатке в значении);
#   dry-run  — посчитать кандидатов и вывести отчёт, ничего не удалять;
#   apply    — удалить подтверждённых кандидатов (требует CLEANUP_ENABLED=true).
# Отсутствующее или неизвестное значение = off. Одна категория не влияет на другую.
# Глобальный выключатель может только ЗАПРЕТИТЬ удаление, но не разрешить его.
# CLEANUP_ENABLED=false
# Устройство загруженных, но не использованных изображений (uploads/images, videos без ссылки в БД).
# CLEANUP_ORPHAN_MODE=off
# Черновики рендера этого запуска: каталог uploads/tmp/<videoId>/<runId> и неудавшийся
# <videoId>.<runId>.part.mp4. Имя содержит UUID запуска, поэтому удаляется только то,
# что записал сам этот запуск (проверяется по mtime). Чужой файл сохраняется.
# CLEANUP_TMP_MODE=off
# Содержимое uploads/tmp при старте сервера — ЗАБЛОКИРОВАНО (locked).
# Каталог может быть рабочим для рендера, который идёт в другом процессе, а записи о
# владении каталогом нет, поэтому рекурсивная уборка не реализована: apply здесь
# принудительно игнорируется. Сервер только сообщает количество оставшихся записей.
# CLEANUP_UPLOAD_TMP_MODE=off
# Ротация резервных копий data/backups (оставляет BACKUP_KEEP файлов, минимум 1).
# CLEANUP_BACKUPS_MODE=off
# Сколько снапшотов БД хранить (ротация сработает только при CLEANUP_BACKUPS_MODE=apply).
# BACKUP_KEEP=10
# Снять ссылку videos.video_file, если файла действительно нет на диске (каталог прочитан, непуст,
# stat успешен). По умолчанию off: сервер только сообщает о таких видео, строка не меняется.
# CLEANUP_MISSING_LINKS_MODE=off
# Корень хранилища медиа. По умолчанию: ./uploads
# UPLOADS_DIR=./uploads
# Инвентаризация без изменений (только чтение): npm run cleanup:scan [-- --json]

# ── Медиа: FFmpeg и субтитры ──────────────────────────────────────────────────
# FFmpeg/ffprobe поставляются пакетами @ffmpeg-installer/ffmpeg и @ffprobe-installer/ffprobe.
# Переменные нужны только если используются системные бинарники.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Шрифт с кириллицей для субтитров. По умолчанию ищется автоматически
# (Windows: Arial, Linux: DejaVu Sans). Если шрифт не найден — субтитры не отрисуются.
# SUBTITLE_FONT=C:/Windows/Fonts/arialbd.ttf

# ── AI: сценарий (необязательно) ──────────────────────────────────────────────
# Порядок провайдеров. Ошибка настроенного OpenRouter возвращается клиенту без fallback на другую модель.
# Доступные id: openrouter, openai, custom, ollama. Неизвестные id игнорируются.
# AI_PROVIDERS=openrouter,openai,custom,ollama
# AI_TIMEOUT_MS задаёт таймаут для всех AI-провайдеров (по умолчанию: OpenRouter 60000, остальные 20000).
# AI_TIMEOUT_MS=20000

# NVIDIA Nemotron через OpenRouter. Ключ используется только backend.
# По умолчанию модель: nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenAI (любой OpenAI-совместимый API). Без ключа провайдер считается ненастроенным.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Дополнительный OpenAI-совместимый провайдер: настраивается только переменными,
# без правки кода. Заполняется целиком или не заполняется вовсе.
# CUSTOM_AI_LABEL=Мой AI-провайдер
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_MODEL=my-model
# CUSTOM_AI_API_KEY=...

# Ollama — локальная модель. Достаточно установленной Ollama, ключ не нужен.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# Полностью отключить Ollama: true
# OLLAMA_DISABLED=false

# ── Озвучка (TTS) ─────────────────────────────────────────────────────────────
# Порядок провайдеров озвучки. Первый, кто может озвучить язык, и озвучивает.
# Доступные id: edge, google, windows-sapi. По умолчанию: edge, google, windows-sapi
# TTS_PROVIDER_ORDER=edge,google,windows-sapi

# Ограничение набора провайдеров (это фильтр, а не порядок — порядок задаёт TTS_PROVIDER_ORDER):
#   auto   — все настроенные провайдеры (по умолчанию);
#   local  — исключить онлайн-провайдер google (останутся edge и Windows SAPI);
#   google — исключить Windows SAPI.
# Неизвестное значение → auto и предупреждение в логе.
# Важно: «local» не делает озвучку полностью офлайновой — edge-tts тоже работает через интернет.
# Для полностью офлайн-показа: TTS_PROVIDER=local + EDGE_TTS_DISABLED=true.
# По умолчанию: auto
# TTS_PROVIDER=auto

# Сколько попыток отдаётся одному голосу Google TTS (только провайдер google). По умолчанию: 2
# TTS_ATTEMPTS=2

# Edge TTS — бесплатные голоса Microsoft, включая узбекские (uz-UZ-MadinaNeural,
# uz-UZ-SardorNeural). Требует Python 3 и пакет edge-tts в .venv-tts (см. README).
# Интерпретатор Python: приоритет — EDGE_TTS_PYTHON, затем ./.venv-tts, затем python из PATH.
# EDGE_TTS_PYTHON=/opt/bevhub/.venv-tts/bin/python
# Полностью отключить Edge TTS: true
# EDGE_TTS_DISABLED=false
# Таймаут одного запроса к edge-tts, мс. По умолчанию: 30000
# EDGE_TTS_TIMEOUT_MS=30000